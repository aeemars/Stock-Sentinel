
NEON_DATABASE_URL=
NEYNAR_API_KEY=
CRON_SECRET=
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=30
# Optional: set to an importable module that exposes run_workflow(portfolio_id=None).
ROMA_FRAMEWORK_MODULE=

# Option 1: Standard SMTP (e.g. Gmail - NO custom domain needed!)
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
# Your personal developer email where user complaints/questions will be delivered
DEV_NOTIFICATION_EMAIL=your_email@gmail.com

# Option 2: SendByte Transactional Email Service (requires verified custom domain for live delivery)
SENDBYTE_API_KEY=
SENDBYTE_FROM_EMAIL=Stock Sentinel <support@yourdomain.com>
SENDBYTE_WEBHOOK_SECRET=
