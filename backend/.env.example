NEON_DATABASE_URL=
SECRET_KEY=change-to-a-secure-random-32-byte-hex-key
SESSION_COOKIE_SECURE=false
CRON_SECRET=
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=30

# Centralized Caching via Memcached (optional, falls back to in-memory)
MEMCACHED_SERVERS=127.0.0.1:11211

# OpenRouter AI Intelligence Engine (Free tier — no credit card required)
# 1. Create a free account at https://openrouter.ai
# 2. Generate an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Default model (free): meta-llama/llama-3.3-70b-instruct:free
# Alternative (free): google/gemini-2.0-flash-lite:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Support Email Notifications via Standard SMTP (e.g. Gmail - NO custom domain needed!)
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_USE_TLS=true
# Your personal developer email where user complaints/questions will be delivered
DEV_NOTIFICATION_EMAIL=your_email@gmail.com
